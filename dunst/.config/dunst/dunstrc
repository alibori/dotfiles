# ~/.config/dunst/dunstrc
# Theme: pywal (colors overridden by dunstrc.d/99-wal.conf)
# WM: bspwm

[global]
    ### Display ###

    monitor = 0
    follow = mouse

    width = 360
    height = 120
    origin = top-right
    offset = 15x40

    notification_limit = 5

    ### Geometry ###

    progress_bar = true
    progress_bar_height = 8
    progress_bar_frame_width = 1
    progress_bar_min_width = 150
    progress_bar_max_width = 300

    indicate_hidden = yes
    separator_height = 2
    padding = 12
    horizontal_padding = 12
    text_icon_padding = 12
    frame_width = 2
    gap_size = 8

    ### Text ###

    font = JetBrains Mono 10
    line_height = 0
    markup = full

    format = "<b>%s</b>\n%b"

    alignment = left
    vertical_alignment = center

    show_age_threshold = 60
    ellipsize = middle
    ignore_newline = no

    word_wrap = yes
    stack_duplicates = true
    hide_duplicate_count = false

    ### Icons ###

    icon_position = left
    min_icon_size = 32
    max_icon_size = 48
    icon_theme = Papirus-Dark

    ### History ###

    sticky_history = yes
    history_length = 20

    ### Misc ###

    browser = xdg-open
    always_run_script = true
    title = Dunst
    class = Dunst

    corner_radius = 10
    ignore_dbusclose = false
    force_xwayland = false

    ### Mouse ###

    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

    ### Fallback colors (Catppuccin Mocha) ###
    # Hex colors below apply only until wal runs; dunstrc.d/99-wal.conf
    # overrides every color key (see wal/.config/wal/templates/dunst.conf).

    separator_color = frame

