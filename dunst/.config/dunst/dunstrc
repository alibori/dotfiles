[urgency_low]
    background = "#1e1e2e"
    foreground = "#bac2de"
    frame_color = "#313244"
    highlight = "#45475a"
    timeout = 4


[urgency_normal]
    background = "#1e1e2e"
    foreground = "#cdd6f4"
    frame_color = "#cba6f7"
    highlight = "#cba6f7"
    timeout = 6


[urgency_critical]
    background = "#1e1e2e"
    foreground = "#f38ba8"
    frame_color = "#f38ba8"
    highlight = "#f38ba8"
    timeout = 0


### Rules ###

# Volum amb barra de progrés
[volume]
    appname = "volume"
    format = "<b>Volum</b>\n%b"
    frame_color = "#89b4fa"
    highlight = "#89b4fa"
    timeout = 2

# Brillantor amb barra de progrés
[brightness]
    appname = "brightness"
    format = "<b>Brillantor</b>\n%b"
    frame_color = "#f9e2af"
    highlight = "#f9e2af"
    timeout = 2

# Bateria baixa
[battery_low]
    summary = "*Battery*"
    urgency = critical
    frame_color = "#fab387"
    foreground = "#fab387"

# Errors
[errors]
    summary = "*error*"
    urgency = critical
    frame_color = "#f38ba8"
    foreground = "#f38ba8"

