// One-line launcher drawn over polybar's [bar/main]. Colors come from wal.rasi.
@import "~/.config/rofi/themes/wal.rasi"

* {
    font: "JetBrainsMono Nerd Font Bold 10";
}

window {
    location: north;
    anchor:   north;
    width:    100%;
    // polybar height: 26pt at dpi 120 = 43px
    height:   43px;
    border:   0;
    padding:  0 16px;
    background-color: @bar-bg;
    children: [ horibox ];
}

horibox {
    orientation: horizontal;
    spacing:     12px;
    children:    [ prompt, entry, listview ];
}

prompt, entry {
    vertical-align: 0.5;
}

entry {
    expand: false;
    width:  14em;
}

listview {
    layout:  horizontal;
    lines:   100;
    spacing: 4px;
    // Horizontal listviews pin one-line-tall elements to the top, so center
    // them by hand: (43px window - 19px element) / 2. Retune if the font changes.
    padding: 12px 0 0 0;
}

element {
    padding: 0 8px;
}

element selected {
    background-color: transparent;
    text-color:       @bar-accent;
}

element-text {
    vertical-align: 0.5;
}
